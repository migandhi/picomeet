# ---- Core ----
PM_PORT=8080
PM_HOST=127.0.0.1
PM_PUBLIC_URL=https://meet.example.cloudns.ch
PM_DB=./data/picomeet.db
PM_SESSION_DAYS=14

# ---- Hard server-wide safety caps (protect the 1GB droplet) ----
PM_MAX_CONCURRENT_MEETINGS=8
PM_MAX_TOTAL_PARTICIPANTS=60
PM_MAX_ROOM_PARTICIPANTS=12
PM_LECTURE_THRESHOLD=9
PM_MAX_STAGE=4

# ---- STUN / TURN ----
PM_STUN=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
PM_TURN_URL=
PM_TURN_SECRET=
PM_TURN_TTL=7200

# ---- Optional SFU module (v2) ----
PM_SFU_URL=

# ---- Secrets (install.sh generates these) ----
PM_SECRET=change-me-32-bytes-hex
